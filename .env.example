# Environment variables for PharmaGuard
# Copy this to .env and fill in your values. Never commit .env to git.

# Gemini Flash API key (free tier)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# NCBI API key (optional but recommended — raises rate limit from 3 to 10 req/s)
# Register at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your_ncbi_api_key_here
